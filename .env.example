# Copy this file to ".env" and fill in the group's shared Supabase project.
# Get both values from Hieu: Supabase Dashboard → Project Settings → API
# (Project URL + anon public key). One shared project for the whole group.
# After creating/changing .env, restart Metro with: npx expo start -c
# Leave them empty (or skip .env entirely) to run on the local mock data.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Google Gemini — powers the AI study assistant (AiChat screen) and the
# AI practice-quiz generator. Get a free key at Google AI Studio
# (aistudio.google.com). Create a NEW key for this project — do not
# reuse a key that was ever shared in a screenshot or chat.
# Leave the key empty to disable the AI features: the app keeps working
# and the assistant answers with a "not configured" notice instead.
EXPO_PUBLIC_GEMINI_API_KEY=<gemini-api-key>
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
