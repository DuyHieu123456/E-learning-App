# Copy this file to ".env" and fill in the group's shared mockapi endpoint.
# Get the endpoint from Hieu (one shared project for the whole group).
# After creating/changing .env, restart Metro with: npx expo start -c
# Leave it empty (or skip .env entirely) to run on the local mock data.
EXPO_PUBLIC_API_URL=https://<project-id>.mockapi.io/api/v1
